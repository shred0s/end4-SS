  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment", "string.comment"],
      "settings": { "foreground": "{{outline}}", "fontStyle": "italic" }
    },
    {
      "scope": ["keyword", "storage", "storage.type", "storage.modifier", "keyword.control"],
      "settings": { "foreground": "{{primary}}" }
    },
    {
      "scope": ["keyword.operator", "punctuation", "meta.brace", "punctuation.separator", "punctuation.terminator"],
      "settings": { "foreground": "{{on_surface_variant}}" }
    },
    {
      "scope": ["keyword.operator.new", "keyword.operator.expression", "keyword.operator.logical.python", "keyword.operator.word"],
      "settings": { "foreground": "{{primary}}" }
    },
    {
      "scope": ["string", "punctuation.definition.string", "markup.inline.raw", "markup.fenced_code"],
      "settings": { "foreground": "{{green}}" }
    },
    {
      "scope": ["constant.character.escape", "string.regexp", "constant.other.placeholder", "constant.character.format"],
      "settings": { "foreground": "{{cyan}}" }
    },
    {
      "scope": ["constant.numeric", "constant.language", "constant.character", "constant.other", "support.constant", "variable.other.constant", "variable.other.enummember"],
      "settings": { "foreground": "{{red}}" }
    },
    {
      "scope": ["entity.name.function", "support.function", "meta.function-call.generic", "variable.function"],
      "settings": { "foreground": "{{blue}}" }
    },
    {
      "scope": ["entity.name.type", "entity.name.class", "entity.name.namespace", "entity.other.inherited-class", "support.type", "support.class", "storage.type.java", "storage.type.cs", "entity.name.type.module"],
      "settings": { "foreground": "{{yellow}}" }
    },
    {
      "scope": ["variable", "meta.definition.variable", "entity.name.variable"],
      "settings": { "foreground": "{{on_surface}}" }
    },
    {
      "scope": ["variable.parameter", "meta.parameter"],
      "settings": { "foreground": "{{secondary}}", "fontStyle": "italic" }
    },
    {
      "scope": ["variable.language", "variable.language.this", "variable.language.self", "variable.language.super"],
      "settings": { "foreground": "{{primary}}", "fontStyle": "italic" }
    },
    {
      "scope": ["variable.other.property", "variable.other.object.property", "meta.object-literal.key", "support.type.property-name", "entity.name.tag.yaml", "support.variable.property"],
      "settings": { "foreground": "{{tertiary}}" }
    },
    {
      "scope": ["meta.decorator", "entity.name.function.decorator", "punctuation.decorator", "storage.type.annotation", "meta.attribute", "entity.name.function.macro"],
      "settings": { "foreground": "{{magenta}}" }
    },
    {
      "scope": ["entity.name.tag", "punctuation.definition.tag"],
      "settings": { "foreground": "{{primary}}" }
    },
    {
      "scope": ["support.class.component", "entity.name.tag.custom"],
      "settings": { "foreground": "{{yellow}}" }
    },
    {
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "{{tertiary}}" }
    },
    {
      "scope": ["entity.other.attribute-name.class.css", "entity.other.attribute-name.id.css", "entity.other.attribute-name.pseudo-class.css"],
      "settings": { "foreground": "{{yellow}}" }
    },
    {
      "scope": ["support.type.property-name.css", "support.type.vendored.property-name.css"],
      "settings": { "foreground": "{{tertiary}}" }
    },
    {
      "scope": ["markup.heading", "markup.heading entity.name", "punctuation.definition.heading.markdown"],
      "settings": { "foreground": "{{primary}}", "fontStyle": "bold" }
    },
    {
      "scope": ["markup.bold"],
      "settings": { "fontStyle": "bold" }
    },
    {
      "scope": ["markup.italic"],
      "settings": { "fontStyle": "italic" }
    },
    {
      "scope": ["markup.strikethrough"],
      "settings": { "fontStyle": "strikethrough" }
    },
    {
      "scope": ["markup.underline.link", "string.other.link", "markup.link"],
      "settings": { "foreground": "{{tertiary}}" }
    },
    {
      "scope": ["markup.quote"],
      "settings": { "foreground": "{{on_surface_variant}}", "fontStyle": "italic" }
    },
    {
      "scope": ["markup.list punctuation.definition.list.begin", "beginning.punctuation.definition.list.markdown"],
      "settings": { "foreground": "{{primary}}" }
    },
    {
      "scope": ["markup.inserted", "meta.diff.header.to-file", "punctuation.definition.inserted"],
      "settings": { "foreground": "{{green}}" }
    },
    {
      "scope": ["markup.deleted", "meta.diff.header.from-file", "punctuation.definition.deleted"],
      "settings": { "foreground": "{{error}}" }
    },
    {
      "scope": ["markup.changed", "punctuation.definition.changed"],
      "settings": { "foreground": "{{yellow}}" }
    },
    {
      "scope": ["meta.diff.range", "meta.diff.header"],
      "settings": { "foreground": "{{blue}}" }
    },
    {
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "{{error}}" }
    },
    {
      "scope": ["invalid.deprecated"],
      "settings": { "foreground": "{{yellow}}", "fontStyle": "strikethrough" }
    }
  ]
}

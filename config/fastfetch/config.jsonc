{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": null,
    "display": {
        "separator": "  ",
        "color": { "keys": "38;2;229;225;227", "output": "38;2;229;225;227" },
        "constants": ["\u001b[38;2;229;225;227m", "\u001b[38;2;200;196;214m"]
    },
    "modules": [
        "break",
        {
            "type": "custom",
            "key": "╭───────────────────────────────────╮"
        },
        {
            "type": "kernel",
            "key": "│ {$2}{$1}  kernel",
            "format": "{$2}{release>22}{$1} │"
        },
        {
            "type": "command",
            "key": "│ {$2}{$1}  uptime",
            "text": "uptime -p | cut -d ' ' -f 2-",
            "format": "{$2}{>22}{$1} │"
        },
        {
            "type": "shell",
            "key": "│ {$2}{$1}  shell ",
            "format": "{$2}{pretty-name>22}{$1} │"
        },
        {
            "type": "command",
            "key": "│ {$2}{$1}  mem   ",
            "text": "free -m | awk 'NR==2{printf \"%.2f GiB / %.2f GiB\",$3/1024,$2/1024}'",
            "format": "{$2}{>22}{$1} │"
        },
        {
            "type": "packages",
            "key": "│ {$2}{$1}  pkgs  ",
            "format": "{$2}{all>22}{$1} │"
        },
        {
            "type": "command",
            "key": "│ {$2}{$1}  user  ",
            "text": "echo $USER",
            "format": "{$2}{>22}{$1} │"
        },
        {
            "type": "command",
            "key": "│ {$2}{$1}  hname ",
            "text": "hostnamectl hostname",
            "format": "{$2}{>22}{$1} │"
        },
        {
            "type": "os",
            "key": "│ {$2}󰻀{$1}  distro",
            "format": "{$2}{pretty-name>22}{$1} │"
        },
        {
            "type": "custom",
            "key": "╰───────────────────────────────────╯"
        },
        "break"
    ]
}
